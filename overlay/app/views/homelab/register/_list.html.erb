<%# locals: (entries:, account: nil, view_ctx: "global") %>
<%# Homelab overlay (not upstream Sure): condensed, Quicken-style register.
    One line per entry, no day cards. `account` is the single account the
    list shows (account Activity tab, or the transactions list filtered to
    one account); only then is the running balance column shown. The caller
    keeps its own selection bar, bulk-select controller and pagination. %>
<% entries = register_dedupe_transfers(entries) %>
<% single_account = account.present? %>
<% balances = running_balances(entries, account) %>
<%# Columns follow the list's own width (container queries), not the
    viewport: the activity tab sits between two sidebars. Narrow: date, name,
    amount. @md (28rem): + select, category, balance, memo. @2xl (42rem): + tags. %>
<% grid = if single_account
     "grid-cols-[4rem_minmax(0,1fr)_auto] @md:grid-cols-[1rem_3.75rem_minmax(0,1.5fr)_minmax(0,1fr)_5.75rem_6.25rem_minmax(0,1fr)] @2xl:grid-cols-[1rem_3.75rem_minmax(0,2fr)_minmax(0,1.2fr)_minmax(0,0.7fr)_6.5rem_7rem_minmax(0,1.4fr)]"
   else
     "grid-cols-[4rem_minmax(0,1fr)_auto] @md:grid-cols-[1rem_3.75rem_minmax(0,1.5fr)_minmax(0,1fr)_6.25rem_minmax(0,1.2fr)] @2xl:grid-cols-[1rem_3.75rem_minmax(0,2fr)_minmax(0,1.2fr)_minmax(0,0.7fr)_6.5rem_minmax(0,1.6fr)]"
   end %>

<div id="homelab-register" class="homelab-register @container" data-testid="homelab-register">
  <div class="grid <%= grid %> items-center gap-x-2 h-8 px-2 mb-1 bg-container-inset rounded-lg text-xs uppercase font-medium text-secondary">
    <div class="hidden @md:flex items-center">
      <%= check_box_tag "selection_entry",
            class: "checkbox checkbox--light hidden lg:block",
            data: {
              action: "bulk-select#togglePageSelection",
              checkbox_toggle_target: "selectionEntry"
            } %>
    </div>
    <p><%= t("homelab.register.date") %></p>
    <p class="truncate"><%= t("homelab.register.payee") %></p>
    <p class="hidden @md:block truncate"><%= t("homelab.register.category") %></p>
    <p class="hidden @2xl:block truncate"><%= t("homelab.register.tags") %></p>
    <p class="justify-self-end"><%= t("homelab.register.amount") %></p>
    <% if single_account %>
      <p class="hidden @md:block justify-self-end" title="<%= t("homelab.register.balance_title") %>"><%= t("homelab.register.balance") %></p>
    <% end %>
    <p class="hidden @md:block truncate"><%= single_account ? t("homelab.register.memo") : t("homelab.register.account_memo") %></p>
  </div>

  <div class="divide-y divide-subdued">
    <% entries.each do |entry| %>
      <%= render "homelab/register/row",
            entry: entry,
            row: balances[entry.id],
            account: account,
            grid: grid,
            view_ctx: view_ctx %>
    <% end %>
  </div>
</div>
